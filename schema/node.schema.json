{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Node (учебный слой) v0.1 — НАША схема; официальной от организаторов нет",
  "description": "Формат закреплён нами по полям из ТЗ (раздел «Задание», часть 1). При выдаче официальной схемы написать конвертер.",
  "type": "object",
  "required": ["id", "order", "title", "book_title", "difficulty", "core", "claims", "links"],
  "properties": {
    "_stub": {"type": "boolean"},
    "_selftest": {"type": "boolean"},
    "_note": {"type": "string"},
    "id": {"type": "string", "minLength": 3},
    "order": {"type": "integer"},
    "why_before": {"type": "string", "description": "Почему этот узел раньше следующего (ТЗ)"},
    "title": {"type": "string", "minLength": 3},
    "book_title": {"type": "string"},
    "source_units": {"type": "array", "items": {"type": "string"}, "description": "id единиц главы, покрытых узлом (для таблицы покрытия)"},
    "difficulty": {
      "type": "object", "required": ["primary"],
      "properties": {
        "primary": {"$ref": "#/$defs/difficulty"},
        "secondary": {"$ref": "#/$defs/difficulty"},
        "threshold": {"type": "string", "description": "метка пороговой идеи"}
      }
    },
    "core": {
      "type": "object", "required": ["essence"],
      "properties": {
        "essence": {"$ref": "#/$defs/para"},
        "mechanism": {"$ref": "#/$defs/para"},
        "practice": {"$ref": "#/$defs/para"},
        "nuances": {"$ref": "#/$defs/para"},
        "deeper": {"$ref": "#/$defs/para", "description": "ветка «глубже»"}
      }
    },
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "kind", "text", "quote", "page", "origin"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["observation", "conclusion", "assumption"]},
          "text": {"type": "string"},
          "quote": {"type": "string", "description": "дословная цитата автора"},
          "page": {"type": ["integer", "null"]},
          "origin": {"enum": ["author", "model"]}
        }
      }
    },
    "conditions": {"type": "string", "description": "цифры и условия: пороги, диапазоны, применимость"},
    "misconception": {"type": "string"},
    "data_meaning": {"type": "string", "description": "что это значит для данных; только выводы из главы, остальное — гипотеза"},
    "hypotheses": {"type": "array", "items": {"type": "string"}},
    "it_analogy": {
      "type": "object", "required": ["analogy", "breaks_where"],
      "properties": {"analogy": {"type": "string"}, "breaks_where": {"type": "string"}}
    },
    "current_practice": {"type": "string", "description": "«как это делается сейчас», если книга описывает устаревшую технику"},
    "inefficiency_lens": {
      "type": "object",
      "properties": {
        "inputs": {"type": "array", "items": {"type": "string"}},
        "manual_steps": {"type": "array", "items": {"type": "string"}},
        "judgment_points": {"type": "array", "items": {"type": "string"}},
        "time_estimate": {"type": "string"},
        "typical_errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object", "required": ["to", "type"],
        "properties": {"to": {"type": "string"}, "type": {"enum": ["prerequisite", "example", "refutes_misconception", "to_data"]}}
      }
    },
    "worked_examples": {
      "type": "array",
      "items": {"type": "object", "required": ["condition", "steps", "result"],
                "properties": {"condition": {"type": "string"}, "steps": {"type": "array", "items": {"type": "string"}},
                               "result": {"type": "string"}, "page": {"type": ["integer", "null"]}}}
    },
    "book_problems": {
      "type": "array",
      "items": {"type": "object", "required": ["number", "text"],
                "properties": {"number": {"type": "string"}, "text": {"type": "string"}, "figure": {"type": "string"},
                               "page": {"type": ["integer", "null"]}}}
    },
    "data_step": {"type": "boolean"},
    "data_solution": {
      "type": "object", "required": ["features", "rule", "conclusion"],
      "properties": {"task": {"type": "string"}, "features": {"type": "array", "items": {"type": "string"}},
                     "rule": {"type": "string"}, "conclusion": {"type": "string"}, "breaks": {"type": "string"}}
    },
    "route": {
      "type": "object",
      "properties": {
        "format": {"enum": ["text", "interactive", "animation", "short_9x16", "explainer_16x9", "data_practicum", "cards"]},
        "why": {"type": "string"},
        "video_worthy": {"type": "boolean"},
        "frame_classes": {"type": "array", "items": {"enum": ["A", "B", "C", "D"]}}
      }
    },
    "illustrations": {
      "type": "array",
      "items": {"type": "object", "required": ["file", "alt", "class"],
                "properties": {"file": {"type": "string"}, "alt": {"type": "string"}, "class": {"enum": ["A", "B", "C", "D"]},
                               "label": {"type": "string"}, "caption": {"type": "string"},
                               "generated": {"type": "boolean"}, "redrawn_from_book": {"type": "boolean"}}}
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "type", "question", "claim_id", "explanation"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["single", "multi", "order", "fill", "calc"]},
          "question": {"type": "string"},
          "options": {"type": "array", "items": {"type": "string"}},
          "answer": {},
          "tolerance": {"type": "number"},
          "unit": {"type": "string"},
          "claim_id": {"type": "string"},
          "explanation": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "difficulty": {"enum": ["mechanism", "geo_time", "indirect_measurement", "formalism", "space", "procedure", "uncertainty", "recognition"]},
    "para": {
      "oneOf": [
        {"type": "string"},
        {"type": "object", "required": ["text", "claims"],
         "properties": {"text": {"type": "string"}, "claims": {"type": "array", "items": {"type": "string"}}}}
      ]
    }
  }
}
